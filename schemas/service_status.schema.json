{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ServiceStatus",
  "description": "The VPN service status returned by GET /services/vpn/status (BR04).",
  "type": "object",
  "required": [
    "service",
    "status",
    "updated_at"
  ],
  "additionalProperties": false,
  "properties": {
    "service": {
      "type": "string",
      "const": "vpn"
    },
    "status": {
      "type": "string",
      "enum": ["operational", "degraded", "outage"]
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "message": {
      "type": "string"
    }
  }
}
